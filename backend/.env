# Port on which the Node.js server will run
# Example: http://localhost:5001
PORT=5001

# Database host address
# "localhost" means the database is running on the same machine as the server
DB_HOST=localhost

# Database username used to connect to MySQL
DB_USER=root

# Database password for the given user
DB_PASSWORD=root

# Name of the database schema used by the application
DB_NAME=hospital

# Port on which the MySQL database server is listening
# 8889 is commonly used by tools like MAMP
DB_PORT=8889
